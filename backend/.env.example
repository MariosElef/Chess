# The server reads these from the process environment (no .env loader); export them or prefix
# the command with them.

# Required: the Postgres from docker-compose.yml.
DATABASE_URL=postgres://chess:change-me@localhost:5433/chess

# Where the server listens; this computer only by default.
# BIND_ADDR=127.0.0.1:8080

# Where puzzles come from before the Lichess puzzle database is imported.
# LICHESS_URL=https://lichess.org

# Log levels, as tracing's EnvFilter reads them.
# RUST_LOG=chess_backend=info,tower_http=info
