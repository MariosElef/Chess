# The server's settings: copy to .env.prod, fill in, and `stackup deploy` sends it as the
# server's .env. Never committed.
POSTGRES_USER=chess
POSTGRES_PASSWORD=
POSTGRES_DB=chess
# The Cloudflare tunnel; leave it out on a development machine.
COMPOSE_PROFILES=tunnel
# The tunnel's token, from Cloudflare: Zero Trust → Networks → Tunnels → the chess tunnel.
TUNNEL_TOKEN=
