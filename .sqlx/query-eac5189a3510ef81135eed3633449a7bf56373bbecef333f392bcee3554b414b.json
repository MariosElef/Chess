{
  "db_name": "PostgreSQL",
  "query": "-- Emails are stored lowercased; usernames keep their case but are unique without it. Guests\n-- have no password, so they are never found here.\nSELECT\n    users.id,\n    users.email,\n    users.username,\n    users.created_at,\n    users.guest_number IS NOT NULL AS \"guest!\",\n    users.avatar_hash AS avatar,\n    users.password_hash\nFROM account.users\nWHERE\n    (users.email = lower($1) OR lower(users.username) = lower($1))\n    AND users.deleted_at IS NULL\n    AND users.guest_number IS NULL\n",
