{
  "db_name": "PostgreSQL",
  "query": "-- The game $1, if $2 played in it and it ended in the last ten minutes, finished or aborted: a\n-- rematch replays it.\nSELECT\n    games.white_id,\n    games.black_id,\n    games.initial_s,\n    games.increment_s,\n    games.rated\nFROM play.games\nWHERE\n    games.id = $1\n    AND (games.white_id = $2 OR games.black_id = $2)\n    AND games.status IN ('finished', 'aborted')\n    AND games.finished_at > now() - interval '10 minutes'\n",
