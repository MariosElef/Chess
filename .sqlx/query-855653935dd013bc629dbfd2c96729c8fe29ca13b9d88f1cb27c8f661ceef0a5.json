{
  "db_name": "PostgreSQL",
  "query": "-- Walks puzzles_rating_id_idx from the given point, so a random point gives a random puzzle,\n-- skipping the ones the player has already attempted.\nSELECT\n    puzzles.id,\n    puzzles.fen,\n    puzzles.moves,\n    puzzles.rating,\n    puzzles.nb_plays,\n    puzzles.themes\nFROM puzzle.puzzles\nWHERE\n    puzzles.rating BETWEEN $1 AND $2\n    AND (puzzles.rating, puzzles.id) >= ($3, $4)\n    AND NOT EXISTS (\n        SELECT 1\n        FROM puzzle.puzzle_attempts\n        WHERE puzzle_attempts.user_id = $5 AND puzzle_attempts.puzzle_id = puzzles.id\n    )\nORDER BY puzzles.rating, puzzles.id\nLIMIT 1\n",
